---
import '../styles/global.css';
import { previewNoIndex, productionOrigin, siteName } from '../config';
import { bookHref, href } from '../lib/url';
import { bookableArtists, confirm, portrait, shop } from '../data/shop';
import { parlorJsonLd } from '../lib/schema';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: unknown;
  /** Artist pages pass "#book" so the sticky Book button jumps to that calendar. */
  stickyBookHref?: string;
}

const { title, description, path, ogTitle = title, ogDescription = description, jsonLd, stickyBookHref } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(path, productionOrigin).href;
const ogImage = new URL('/og/fearless-share.jpg', productionOrigin).href;
const robots = previewNoIndex ? 'noindex, nofollow' : 'index, follow';
const schemas = [parlorJsonLd(ogImage), jsonLd].flat().filter(Boolean);
const nav = [
  ['Team', '/team/'],
  ['Rates', '/#rates'],
  ['Walk-ins', '/#hours'],
  ['Reviews', '/#reviews'],
  ['Aftercare', '/aftercare/'],
  ['Contact', '/contact/'],
];
const current = (itemPath: string) => itemPath === path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/png" href={`${base}favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <!-- analytics: not connected. Placeholder only. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce');
      }
    </script>
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body style={`--crest:url('${base}hero-crest.webp');--grain:url('${base}grain.png')`}>
    <div class="noise" aria-hidden="true"></div>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={href('/')}>
        <img src={`${base}icons/fl-monogram.png`} width="28" height="48" alt="" />
        <span>
          <strong>Fearless</strong>
          <small>Tattoos · Ottawa</small>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Primary">
        {nav.map(([label, itemPath]) => (
          <a href={href(itemPath)} aria-current={current(itemPath) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="btn primary header-cta" href={bookHref('/book/')} data-open-picker>Book / Get a quote</a>
      <details class="mobile-nav">
        <summary>
          <span class="burger" aria-hidden="true"></span>
          <span class="sr-only">Menu</span>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Mobile">
            {nav.map(([label, itemPath]) => (
              <a href={href(itemPath)} aria-current={current(itemPath) ? 'page' : undefined}>{label}</a>
            ))}
            <a href={href('/policies/')}>Policies</a>
            <a href={href('/faq/')}>FAQ</a>
            <a href={bookHref('/book/')} data-open-picker>Book / Get a quote</a>
            <a href={`tel:${shop.phoneTel}`}>Call {shop.phoneDisplay}</a>
            <a href={`sms:${shop.phoneTel}`}>Text {shop.phoneDisplay}</a>
          </nav>
        </div>
      </details>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <img src={`${base}icons/wordmark-white.png`} width="220" height="111" alt="Fearless Tattoos" />
          <p class="staging">Staging preview</p>
          <p><a href={`tel:${shop.phoneTel}`}>{shop.phoneDisplay}</a><br /><a href={`mailto:${shop.email}`}>{shop.email}</a></p>
          <p>{shop.area}</p>
          <p class="confirm">{confirm.street}</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={href('/team/')}>Artists</a>
          <a href={href('/aftercare/')}>Aftercare</a>
          <a href={href('/policies/')}>Policies</a>
          <a href={href('/faq/')}>FAQ</a>
          <a href={href('/contact/')}>Contact</a>
        </nav>
        <div class="footer-links">
          <a href={shop.instagram} rel="noopener noreferrer">Instagram {shop.instagramHandle}</a>
          <a href={shop.facebook} rel="noopener noreferrer">Facebook</a>
          <a href="https://fearlesstattoos.com/">Current live site</a>
        </div>
      </div>
    </footer>

    <div class="sticky-bar">
      <p class="sticky-note">Walk-ins 12–5 · {shop.walkInMinimum} minimum</p>
      <div class="sticky-actions">
        {stickyBookHref ? (
          <a class="btn primary" href={stickyBookHref}>Book<span class="sr-only"> this artist</span></a>
        ) : (
          <a class="btn primary" href={bookHref('/book/')} data-open-picker>Book<span class="sr-only"> / Get a quote</span></a>
        )}
        <a class="btn ghost" href={`tel:${shop.phoneTel}`}>Call</a>
        <a class="btn ghost" href={`sms:${shop.phoneTel}`}>Text</a>
      </div>
    </div>

    <dialog class="picker" id="artist-picker" aria-labelledby="picker-title">
      <div class="picker-head">
        <h2 id="picker-title">Pick your artist</h2>
        <button class="icon-btn" type="button" data-close-picker>Close</button>
      </div>
      <p>Walk-ins 12–5, {shop.walkInMinimum} minimum.</p>
      <ul class="picker-list">
        {bookableArtists.map((artist) => (
          <li>
            <a data-track href={bookHref(`/${artist.slug}/`)}>
              <Image src={portrait(artist.id)} alt="" width={112} height={112} widths={[112]} format="webp" quality={60} />
              <span>
                <strong>{artist.name}</strong>
                <small>{artist.role} · {artist.rateShort}</small>
              </span>
            </a>
          </li>
        ))}
        <li>
          <a data-track href={bookHref('/cocobookings/', 'prefer=any')}>
            <span class="any-mark" aria-hidden="true">?</span>
            <span>
              <strong>Any artist / not sure</strong>
              <small>Opens Coco’s calendar for now</small>
            </span>
          </a>
        </li>
      </ul>
      <p class="confirm">{confirm.anyArtist}</p>
    </dialog>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>

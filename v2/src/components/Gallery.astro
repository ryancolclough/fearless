---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alts: string[];
}
const { images, alts } = Astro.props;
---

<div class="gallery">
  {images.map((image, index) => (
    <a href={image.src} target="_blank" rel="noopener noreferrer">
      <Image
        src={image}
        alt={alts[index] ?? 'Portfolio photo at Fearless Tattoos in Ottawa'}
        widths={[360, 720]}
        sizes="(min-width: 1040px) 22vw, (min-width: 700px) 30vw, 50vw"
        loading="lazy"
        format="webp"
        quality={68}
      />
    </a>
  ))}
</div>
